    "call-graph",
    "typescript",
    "oxc",
    "retrieval",
    "agent"
  ],
  "homepage": "https://github.com/iantocristian/jscout#readme",
  "bugs": "https://github.com/iantocristian/jscout/issues",
  "repository": {
