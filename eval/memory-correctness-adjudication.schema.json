{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blind_case", "verdict", "reason", "missing_boundaries", "unjustified_boundaries"],
        "properties": {
          "blind_case": { "type": "string" },
          "verdict": {
            "type": "string",
            "enum": ["correct", "acceptable_alternative", "incorrect"]
          },
          "reason": { "type": "string" },
          "missing_boundaries": {
            "type": "array",
            "items": { "type": "string" }
          },
          "unjustified_boundaries": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
