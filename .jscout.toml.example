# Repository-local, non-secret jscout runtime policy.
# Copy this file to <repository>/.jscout.toml, or run:
#   jscout config init <repository>
version = 1

[database]
path = ".jscout.db"

[docs]
enabled = true
include = ["**/*.md", "**/*.mdx"]
exclude = []

[docs.search]
vector = true
rerank = true
freshness = false
max_rank_movement = 2
limit = 10
response_bytes = 24000

[search]
vector = true
rerank = true
attach_memory = false
limit = 10
response_bytes = 24000
file_roles = []
origins = ["repository", "workspace"]
memory_limit = 4
memory_depth = 2
memory_nodes = 2000

[search.expansion]
enabled = false
mode = "paths" # paths (compact default) or neighborhood (diagnostic)
depth = 1
seeds = 3
paths = 8
nodes = 40
edges = 120
bytes = 24000
min_confidence = "likely"
file_roles = ["production", "unknown"]

# Provider selection is explicit. An API key alone never enables embeddings.
# [embedding]
# provider = "local" # local, voyage, openai, or none
# model = "BAAI/bge-m3"
# revision = "5617a9f61b028005a4858fdac845db406aefb181"
# batch = 64
# origins = ["repository", "workspace"]
# api_key_env = "OPENAI_API_KEY" # variable name only; never put the key here
# url = "https://embedding-gateway.example.com/v1/embeddings"
# query_prefix = ""

[inference]
url = "http://127.0.0.1:8792"
host = "127.0.0.1"
port = 8792
uv = "uv"
allow_remote = false
batch_size = 16
max_length = 4096
# project = "/absolute/path/to/jscout/inference"
# model_cache_root = "~/.cache/jscout/models"

[reranker]
# url = "http://127.0.0.1:8792/rerank"
model = "BAAI/bge-reranker-v2-m3"
# revision = "953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e"
top = 50
max_chars = 4000

[llm]
model = "openai-codex:gpt-5.6-terra"
# reasoning = "high"
# Scouting is serialized by default. Increase deliberately when the selected
# provider/account can sustain overlapping requests.
max_concurrency = 1
# For API-key OpenAI through a Responses-compatible gateway:
# model = "openai:gpt-5.6-terra"
# openai_base_url = "https://gateway.example.com/v1"
api_key_env = "OPENAI_API_KEY"
auth_file = "~/.pi-ai/auth.json"

# Additional OpenAI-compatible provider example. The key is read from the
# named environment variable only when this provider is selected.
# [[llm.openai_compatible_providers]]
# id = "local"
# name = "Local model server"
# base_url = "http://127.0.0.1:1234/v1"
# api_key_env = "LOCAL_LLM_API_KEY"
#
# [[llm.openai_compatible_providers.models]]
# id = "qwen3:32b"
# name = "Qwen 3 32B"
# reasoning = true
# context_window = 131072
# max_tokens = 32768

[sidecars]
node = "node"
# gateway = "/absolute/path/to/gateway/src/main.mjs"
# checker = "/absolute/path/to/checker/src/main.mjs"

[mcp]
# core registers the production-selected surface (search, definition, who_uses,
# calls, file_outline, events, documentation_search); full adds semantic memory,
# repository_overview, neighborhood, entities, paths, and annotate. baseline and
# structural remain accepted aliases.
profile = "core"
# Optional per-project allowlist; only narrows what the profile registers.
# tools = ["semantic_search", "definition", "who_uses"]
source_view = "full"
# auto emits structuredContent only to clients verified by jscout while always
# retaining the JSON-text fallback. Use text for universal compatibility or
# structured to test/force the dual-form MCP response with another client.
result_transport = "auto"

[telemetry]
# file = ".jscout/telemetry.jsonl"
# request_log = ".jscout/requests.jsonl"

[diagnostics]
timing = false
debug = false

[index]
dependencies = []

[watch]
embed = false
product = false
dependencies = []
enrich = false
enrich_timeout_seconds = 300
debounce_ms = 2000
reconcile_seconds = 600
