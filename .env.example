# jscout reads process environment variables; it does not auto-load this file.
# Copy to .env and source it from your shell if you want local overrides.

# Generative scouting defaults to this ChatGPT-plan-backed provider/model.
JSCOUT_LLM_MODEL=openai-codex:gpt-5.6-terra
# Optional. Omit to use the provider default.
# JSCOUT_LLM_REASONING=high

# API-key OpenAI through an OpenAI Responses-compatible gateway:
# JSCOUT_LLM_MODEL=openai:gpt-5.6-terra
# OPENAI_API_KEY=
# JSCOUT_PI_AI_OPENAI_BASE_URL=https://gateway.example.com/v1

# pi-ai uses its OAuth store for openai-codex. Never commit the real file.
JSCOUT_PI_AI_AUTH_FILE=~/.pi-ai/auth.json

# Optional development/runtime overrides.
# JSCOUT_NODE=/absolute/path/to/node
# JSCOUT_PI_AI_GATEWAY=/absolute/path/to/gateway/src/main.mjs

# Optional custom OpenAI-compatible generative providers, as validated JSON.
# JSCOUT_PI_AI_OPENAI_COMPATIBLE_PROVIDERS=[]

# Embeddings remain separate from the generative gateway.
# JSCOUT_EMBED_PROVIDER=voyage
# VOYAGE_API_KEY=
# OPENAI_API_KEY=  # The same variable can also select OpenAI embeddings.
# JSCOUT_EMBED_URL=http://localhost:1234/v1/embeddings
# JSCOUT_EMBED_KEY=
# JSCOUT_EMBED_MODEL=

# Optional reranking and diagnostics.
# JSCOUT_RERANK_URL=http://127.0.0.1:8792/rerank
# JSCOUT_RERANK_MODEL=
# JSCOUT_TIMING=1
